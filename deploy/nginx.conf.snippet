# legalskills.cz — nginx reverse proxy in front of the Node app.
#
# Node serves the whole site (pages, /assets, /api, /downloads), so one
# proxy_pass covers everything. nginx only terminates TLS and forwards.
#
#   sudo cp deploy/nginx.conf.snippet /etc/nginx/sites-available/legalskills.cz
#   sudo ln -s /etc/nginx/sites-available/legalskills.cz /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx

server {
    listen 80;
    server_name legalskills.cz www.legalskills.cz;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name legalskills.cz www.legalskills.cz;

    ssl_certificate     /etc/letsencrypt/live/legalskills.cz/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/legalskills.cz/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:8765;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# Purge expired 48h download tokens hourly (cron):
#   0 * * * * cd /srv/www/legalskills.cz && /usr/bin/node scripts/download_api.mjs --cleanup
